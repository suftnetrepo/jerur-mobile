# This project uses Expo's Continuous Native Generation (managed
# workflow, config plugins in app.json) - native projects are generated
# on demand by `expo prebuild` / `expo run:ios` / `expo run:android`, not
# committed. Regenerate locally when you need a native build.
/ios
/android

# Android release upload keystore (jerur-sa.jks, alias jerur02) - the
# real signing key for the live Play Store listing (com.suftnet.jerur).
# Kept outside /android since that's regenerated by prebuild; never
# commit this.
/credentials
