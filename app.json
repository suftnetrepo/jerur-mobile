{
  "expo": {
    "name": "Jerur",
    "slug": "jerur",
    "version": "1.0.16",
    "scheme": "jerur",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      "./plugins/withStripUnusedLocationPurposeStrings",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Jerur uses your location to find Winners Chapel campuses near you. For example, when you tap \"Find churches near me\" on the church search screen, we use your current location to show the nearest campuses so you can pick the right one to attend."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.suftnet.jerur",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B2340",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.suftnet.jerur"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
